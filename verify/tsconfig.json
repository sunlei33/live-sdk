{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "jsx": "react-jsx",
    "paths": {
      "live-sdk": ["src/index.ts"],
      "live-sdk/ui": ["src/ui/index.ts"],
      "live-sdk/react": ["src/adapters/react.ts"],
      "live-sdk/vue": ["src/adapters/vue.ts"]
    }
  },
  "include": ["./contract.ts"]
}
